generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("user")
  image     String?   
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Villa {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Float
  images      String[]  @default([])
  isAvailable Boolean   @default(true)
  facilities  String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Booking {
  id            String   @id @default(cuid())
  reservationId String   @unique @default(cuid())
  userId        String?
  villaId       String?
  room          String?
  customerName  String?
  customerPhone String?
  guests        Int?
  nights        Int?
  pricePerNight Float?
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Float
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  villa Villa? @relation(fields: [villaId], references: [id])
}

model Wisata {
  id          String   @id @default(cuid())
  name        String
  description String
  distance    String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Kuliner {
  id          String   @id @default(cuid())
  name        String
  description String
  priceRange  String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
